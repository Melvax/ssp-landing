rules_version = '2';

// Projet partagé avec les apps Flutter : un déploiement remplace toutes les règles.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == 'OXJvsXVGa6fqXwmbbmjoYntZYay2' || request.auth.token.role == 'admin');
    }

    match /landing-events/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Fichiers de l'app newssp
    match /events/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
