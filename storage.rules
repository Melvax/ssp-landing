rules_version = '2';

// ATTENTION : ce projet Firebase est partagé avec les apps Flutter et un déploiement
// remplace toutes les règles. Fusionner avec les règles en ligne avant de déployer.
service firebase.storage {
  match /b/{bucket}/o {
    match /landing-events/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if request.auth != null && request.auth.token.admin == true
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Fichiers de l'app newssp
    match /events/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
